{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Library crate: refresh Cargo.lock for in-range updates instead of raising minimum versions in Cargo.toml",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Batch non-major GitHub Actions updates into a single PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions"
    }
  ]
}
